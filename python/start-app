#!/bin/bash
set -euo pipefail

readonly READY_MESSAGE='[System] App starting'
readonly SYSTEM_PYTHON=/usr/local/bin/python3
readonly DEPENDENCY_STAMP="${VIRTUAL_ENV}/.dependencies-hash"
readonly ENTRY_CANDIDATES=(main.py app.py bot.py)

DEPENDENCY_SOURCE=''

log() {
    printf '\033[1m\033[36m[System]\033[0m %s\n' "$1"
}

fail() {
    printf '\033[1m\033[31m[System]\033[0m %s\n' "$1"
    exit 1
}

is_enabled() {
    [[ "${1:-0}" == "1" || "${1:-}" == "true" ]]
}

git_with_credentials() {
    if [[ -z "${GIT_TOKEN:-}" ]]; then
        git "$@"
        return
    fi

    git -c credential.helper= \
        -c credential.helper='!f() { echo "username=${GIT_USERNAME:-x-access-token}"; echo "password=${GIT_TOKEN}"; }; f' \
        "$@"
}

update_repository() {
    if ! is_enabled "${AUTO_UPDATE:-0}" || [[ ! -d .git ]]; then
        return
    fi

    log 'Pulling the latest changes'
    if ! git_with_credentials pull --ff-only; then
        log 'Could not pull the latest changes, starting with the current files'
    fi
}

python_version() {
    "$SYSTEM_PYTHON" -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")'
}

venv_version() {
    sed -n 's/^version_info *= *\([0-9]*\.[0-9]*\).*/\1/p' "${VIRTUAL_ENV}/pyvenv.cfg" 2>/dev/null
}

prepare_venv() {
    if [[ -x "${VIRTUAL_ENV}/bin/python" && "$(venv_version)" == "$(python_version)" ]]; then
        return
    fi

    if [[ -d "$VIRTUAL_ENV" ]]; then
        log "Recreating .venv for Python $(python_version)"
        rm -rf "$VIRTUAL_ENV"
    fi

    uv venv --quiet --seed --python "$SYSTEM_PYTHON" "$VIRTUAL_ENV" || fail 'Creating the virtual environment failed'
}

has_project_table() {
    grep -q '^\[project\]' pyproject.toml
}

select_dependency_source() {
    if [[ -f uv.lock && -f pyproject.toml ]]; then
        DEPENDENCY_SOURCE='uv.lock'
    elif [[ -f requirements.txt ]]; then
        DEPENDENCY_SOURCE='requirements.txt'
    elif [[ -f pyproject.toml ]] && has_project_table; then
        DEPENDENCY_SOURCE='pyproject.toml'
    fi
}

dependencies_hash() {
    {
        printf 'python %s\n' "$(python_version)"
        printf 'source %s\n' "$DEPENDENCY_SOURCE"
        cat "$DEPENDENCY_SOURCE"
        if [[ "$DEPENDENCY_SOURCE" == 'uv.lock' ]]; then
            cat pyproject.toml
        fi
    } | sha256sum | cut -d ' ' -f 1
}

run_install() {
    case "$DEPENDENCY_SOURCE" in
        uv.lock) uv sync --frozen --no-dev ;;
        requirements.txt) uv pip install --requirement requirements.txt ;;
        pyproject.toml) uv pip install --requirement pyproject.toml ;;
    esac
}

install_dependencies() {
    prepare_venv

    if ! is_enabled "${INSTALL_DEPS:-1}"; then
        return
    fi

    select_dependency_source
    if [[ -z "$DEPENDENCY_SOURCE" ]]; then
        return
    fi

    if [[ -f "$DEPENDENCY_STAMP" && "$(cat "$DEPENDENCY_STAMP")" == "$(dependencies_hash)" ]]; then
        log 'Dependencies are up to date, delete .venv to force a clean install'
        return
    fi

    log "Installing dependencies from ${DEPENDENCY_SOURCE}"
    run_install || fail 'Installing dependencies failed'

    dependencies_hash > "$DEPENDENCY_STAMP"
}

env_file_keys() {
    [[ -f .env ]] || return 0

    sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/\2/p' .env
}

export_defaults() {
    local env_keys
    env_keys="$(env_file_keys)"

    local entry key value
    for entry in "PORT=${SERVER_PORT:-}" 'HOST=0.0.0.0'; do
        key="${entry%%=*}"
        value="${entry#*=}"
        if [[ -z "$value" || -n "${!key:-}" ]] || grep -qxF "$key" <<< "$env_keys"; then
            continue
        fi
        printf -v "$key" '%s' "$value"
        export "${key?}"
    done
}

start_python() {
    local -a python_args=()
    read -r -a python_args <<< "${PYTHON_ARGS:-}"

    printf '%s\n' "$READY_MESSAGE"
    exec python "${python_args[@]}" "$1"
}

start_app() {
    if [[ -n "${START_COMMAND:-}" ]]; then
        printf '%s\n' "$READY_MESSAGE"
        exec /bin/bash -c "$START_COMMAND"
    fi

    if [[ -n "${MAIN_FILE:-}" ]]; then
        [[ -f "$MAIN_FILE" ]] || fail "Main file ${MAIN_FILE} was not found"
        start_python "$MAIN_FILE"
    fi

    local candidate
    for candidate in "${ENTRY_CANDIDATES[@]}"; do
        if [[ -f "$candidate" ]]; then
            start_python "$candidate"
        fi
    done

    fail "Nothing to start: set a main file or a start command, or add one of ${ENTRY_CANDIDATES[*]}"
}

cd /home/container
update_repository
install_dependencies
export_defaults
start_app
